# Build-time settings (Workers Builds → Settings → Build → Variables, or a local .env).
# Absolute origin of the deployed site, no trailing slash. Drives canonical, hreflang,
# sitemap, robots and JSON-LD URLs. Production: https://voxfordofficial.com
SITE_URL=
# "true" only for the production domain build. Anything else renders noindex.
SITE_INDEXABLE=
# Ticket D: public Turnstile site key for the inquiry form (not a secret). Empty = Cloudflare's
# "always passes, invisible" test key 1x00000000000000000000BB, for dev only: a real secret
# rejects its tokens, so set this before the email binding exists (docs/deploy-cloudflare.md).
PUBLIC_TURNSTILE_SITE_KEY=
# Where the build reads the latest reels (ticket E). Default: $SITE_URL/media/reels/manifest.json.
# "off" builds without them (CI does not need it set).
REELS_MANIFEST_URL=
# Where the build reads the newest YouTube uploads (#41). Default: the @voxford.official
# channel's public RSS feed (no key). "off" builds without them.
YOUTUBE_FEED_URL=
