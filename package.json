{
  "name": "voxford-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-info.mjs && astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check && tsc -p worker/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy": "wrangler deploy --var COMMIT_SHA:${WORKERS_CI_COMMIT_SHA:-}",
    "astro": "astro",
    "test:dist": "DIST_CHECKS=1 vitest run",
    "test:layout": "LAYOUT_CHECKS=1 vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "astro": "^7.4.8"
  }
}
