// Cloudflare Workers config (ADR 0001). Static Astro build in dist/ served as
// assets; the Worker in worker/index.ts runs only for the paths below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voxford-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Production is the custom domain below (ticket G). The workers.dev URL is off so it
  // cannot compete with the domain in search; version and preview URLs stay on (they are
  // a separate setting) and Cloudflare marks them noindex.
  "workers_dev": false,
  "preview_urls": true,
  // The apex is a Workers Custom Domain: deploy creates its DNS record and certificate.
  // www → apex is a 301 Redirect Rule on the zone, not the Worker (docs/deploy-cloudflare.md › Domain).
  "routes": [{ "pattern": "voxfordofficial.com", "custom_domain": true }],
  // Workers Builds runs `wrangler preview` on non-main branches, which needs this block.
  // Previews inherit no bindings: they read the same media bucket (they never write it;
  // the reels cron only runs in production).
  "previews": {
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "voxford-media" }]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The chord audio goes through the Worker for byte ranges, which static
    // assets do not answer (worker/asset-ranges.ts).
    "run_worker_first": ["/", "/healthz", "/api/*", "/media/*", "/_astro/*.webm", "/_astro/*.m4a"]
  },
  // Daily reels sync (ticket E fills worker/reels.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true },
  // Top videos and synced reels (ticket E), served by the Worker at /media/*.
  // `wrangler dev` uses a local bucket; fill it with scripts/upload-media.sh --local.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "voxford-media" }],
  // Inquiry email (#65, docs/deploy-cloudflare.md › Inquiry). The zone runs Email Routing and
  // the group's Gmail is a verified destination, so a send to it is free on any plan; the
  // binding can reach no other address. Previews get none of this: their form uses mailto.
  "send_email": [{ "name": "EMAIL", "destination_address": "voxford.official@gmail.com" }],
  "vars": { "INQUIRY_FROM": "inquiry@voxfordofficial.com" },
  // At most 5 emailed attempts a minute per visitor IP and Cloudflare location (worker/inquiry.ts).
  "ratelimits": [{ "name": "INQUIRY_LIMIT", "namespace_id": "6501", "simple": { "limit": 5, "period": 60 } }]
}
