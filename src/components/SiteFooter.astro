---
// Site footer: crest as a seal, contact, management, profiles, all pages.
// Every fact comes from site-facts.
import Crest from '@/components/Crest.astro';
import { GROUP, PROFILE_LABELS, PROFILES, SITE_CREDIT, type ProfileKey } from '@/data/site-facts';
import { getStrings, type Locale } from '@/i18n';
import { FOOTER_PAGES, pathFor } from '@/i18n/routes';
import { withoutEmptyConcerts } from '@/lib/concerts';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getStrings(lang);
const year = new Date().getFullYear();
const footerPages = await withoutEmptyConcerts(FOOTER_PAGES);
---

<footer class="footer">
  <span class="light-line" aria-hidden="true"></span>
  <div class="footer__grid container">
    <div class="footer__brand">
      <Crest width={88} alt="" />
      <p class="footer__tagline">{t.common.footer.tagline}</p>
    </div>

    <div class="footer__col">
      <h2 class="label">{t.common.footer.contactLabel}</h2>
      <p><a href={`mailto:${GROUP.email}`}>{GROUP.email}</a></p>
      <h2 class="label">{t.common.footer.managementLabel}</h2>
      <p>{GROUP.manager.name}, {GROUP.manager.company}</p>
    </div>

    <div class="footer__col">
      <h2 class="label">{t.common.footer.followLabel}</h2>
      <ul class="footer__list">
        {
          (Object.keys(PROFILES) as ProfileKey[]).map((k) => (
            <li>
              <a href={PROFILES[k]} rel="me noopener" target="_blank">
                {PROFILE_LABELS[k]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="footer__col" aria-label={t.common.a11y.footerNav}>
      <ul class="footer__list">
        {
          footerPages.map((p) => (
            <li>
              <a href={pathFor(p, lang)}>{t.common.nav[p]}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="footer__legal container label">
    <p>© {year} {GROUP.name} · {GROUP.handle}</p>
    <p>
      <a class="footer__credit" href={SITE_CREDIT.url} rel="noopener" target="_blank">
        {t.common.footer.credit} <span class="footer__credit-name">{SITE_CREDIT.name}</span>
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--section-gap);
    padding-block-end: var(--space-7);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-7) var(--space-6);
    padding-block: var(--space-8) var(--space-7);
  }

  .footer__brand {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .footer__tagline {
    color: var(--color-text);
  }

  .footer__col {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .footer__col h2:not(:first-child) {
    margin-block-start: var(--space-4);
  }

  .footer__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .footer__list a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.25rem;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-6);
    color: var(--color-text-muted);
  }

  /* The credit: muted like the legal line, with a stage light that sweeps the
     name now and then; on hover or focus the name lights up in the brand glow. */
  .footer .footer__credit {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: 2.25rem;
    color: var(--color-text-muted);
  }

  .footer .footer__credit:hover {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer__credit-name {
    background: var(--gradient-credit) 100% 0 / 300% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition:
      background-position 900ms var(--ease-out),
      filter 300ms ease-out;
  }

  .footer__credit:hover .footer__credit-name,
  .footer__credit:focus-visible .footer__credit-name {
    background-position: 0 0;
    filter: drop-shadow(0 0 0.6rem var(--color-credit-glow));
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer__credit:not(:hover, :focus-visible) .footer__credit-name {
      animation: credit-sweep 11s ease-in-out 3s infinite;
    }
  }

  @keyframes credit-sweep {
    0%,
    82% {
      background-position: 100% 0;
    }
    91% {
      background-position: 50% 0;
    }
    100% {
      background-position: 100% 0;
    }
  }

  @media (forced-colors: active) {
    .footer__credit-name {
      background: none;
      color: LinkText;
    }
  }
</style>
