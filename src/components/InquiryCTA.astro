---
// SEAM (ticket D fills the look; the props are fixed): the inquiry call to
// action. Renders a pill linking to the prefill URL from src/lib/inquiry-url.ts,
// so any page can say "inquire about GOLD for a wedding" without knowing the
// form. Works without JavaScript.
import Pill from '@/components/Pill.astro';
import { getStrings, type Locale } from '@/i18n';
import { inquiryUrl, type InquiryPrefill } from '@/lib/inquiry-url';

export interface Props {
  lang: Locale;
  /** Fields to prefill in the form (the prefill contract in docs/spec.md). */
  prefill?: InquiryPrefill;
  /** Visible label; defaults to "Send an inquiry" / "Pošalji upit". */
  label?: string;
  variant?: 'primary' | 'ghost';
  class?: string;
}

const { lang, prefill, label, variant = 'primary', class: className } = Astro.props;
const t = getStrings(lang);
---

<Pill href={inquiryUrl(lang, prefill)} variant={variant} class:list={['inquiry-cta', `inquiry-cta--${variant}`, className]} data-inquiry-cta>
  <span>{label ?? t.common.cta.inquiry}</span>
  {variant === 'primary' && <span class="inquiry-cta__arrow" aria-hidden="true">→</span>}
</Pill>

<style>
  /* The one action on every page: the primary pill carries a small arrow that leans in on hover. */
  .inquiry-cta__arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  :global(.inquiry-cta:hover) .inquiry-cta__arrow,
  :global(.inquiry-cta:focus-visible) .inquiry-cta__arrow {
    transform: translateX(0.2em);
  }
</style>
