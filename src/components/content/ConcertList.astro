---
// Upcoming public concerts: date, name, place (the venue only when it is
// known), the organizer when a source names one, a one-line description, and
// the organiser's event page when there is one. Public concerts only (spec › Information
// architecture); the caller decides how many and adds the Event JSON-LD.
import type { CollectionEntry } from 'astro:content';
import { format, getStrings, LOCALE_META, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  concerts: readonly CollectionEntry<'concerts'>[];
  /** Heading level of each concert name. */
  level?: 'h2' | 'h3';
}

const { lang, concerts, level = 'h2' } = Astro.props;
const t = getStrings(lang);
const Name = level;
const locale = LOCALE_META[lang].htmlLang;
const month = new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' });
const full = new Intl.DateTimeFormat(locale, { dateStyle: 'full', timeZone: 'UTC' });
const country = new Intl.DisplayNames([locale], { type: 'region' });

const rows = concerts.map((c) => {
  const day = new Date(`${c.data.startDate.slice(0, 10)}T12:00:00Z`);
  const time = /T(\d{2}:\d{2})/.exec(c.data.startDate)?.[1];
  return {
    id: c.id,
    iso: c.data.startDate,
    day: day.getUTCDate(),
    month: month.format(day).replace('.', ''),
    year: day.getUTCFullYear(),
    when: time ? `${full.format(day)}, ${time}` : full.format(day),
    name: c.data.name[lang],
    place: [c.data.venue, c.data.city[lang], country.of(c.data.countryCode)].filter(Boolean).join(' · '),
    organizer: c.data.organizer ? format(t.content.concerts.organizer, { name: c.data.organizer }) : undefined,
    description: c.data.description?.[lang],
    url: c.data.url,
  };
});
---

<ol class="concerts" role="list">
  {
    rows.map((r) => (
      <li class="concerts__item">
        <time class="concerts__date" datetime={r.iso}>
          <span class="numeral concerts__day">{r.day}</span>
          <span class="label">
            {r.month} {r.year}
          </span>
        </time>
        <div class="concerts__body">
          <Name class="concerts__name">{r.name}</Name>
          <p class="concerts__when">{r.when}</p>
          <p class="concerts__place">{r.place}</p>
          {r.organizer && <p class="concerts__organizer">{r.organizer}</p>}
          {r.description && <p class="concerts__description">{r.description}</p>}
          {r.url && (
            <p>
              <a href={r.url} rel="noopener">
                {t.content.concerts.eventPage}
              </a>
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .concerts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .concerts__item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    max-inline-size: none;
    padding-block: var(--space-5);
    border-block-start: var(--line-thin) solid var(--color-border);
  }

  .concerts__item:last-child {
    border-block-end: var(--line-thin) solid var(--color-border);
  }

  .concerts__date {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  .concerts__day {
    font-size: var(--text-title);
  }

  .concerts__body {
    display: grid;
    gap: var(--space-2);
  }

  .concerts__name {
    font-family: var(--font-body);
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
  }

  .concerts__when {
    color: var(--color-text);
  }

  .concerts__when::first-letter {
    text-transform: uppercase;
  }

  .concerts__place,
  .concerts__organizer,
  .concerts__description {
    color: var(--color-text-secondary);
  }
</style>
