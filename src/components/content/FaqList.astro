---
// Questions and answers, all open in the HTML (nothing hidden behind a click:
// spec › Acceptance). The caller passes the same Faq[] it puts into FAQPage
// JSON-LD. `grouped` splits them under the FAQ page's section headings.
import { getStrings, type Locale } from '@/i18n';
import type { Faq } from '@/lib/faq';
import { FAQ_GROUPS } from '@/lib/faq-groups';

interface Props {
  lang: Locale;
  faqs: readonly Faq[];
  id: string;
  heading: string;
  /** Show the visible h2 (off on the FAQ page, whose h1 is the heading). */
  showHeading?: boolean;
  grouped?: boolean;
  /** Link to the full FAQ page under a page's block. */
  more?: { href: string; label: string };
}

const { lang, faqs, id, heading, showHeading = true, grouped = false, more } = Astro.props;
const t = getStrings(lang);
const groups = grouped
  ? FAQ_GROUPS.map((g) => ({ key: g, title: t.content.faq.groups[g], items: faqs.filter((f) => f.group === g) })).filter(
      (g) => g.items.length > 0,
    )
  : [{ key: 'all', title: undefined, items: faqs }];
// Questions sit one level under the nearest visible heading.
const QLevel = showHeading || grouped ? 'h3' : 'h2';
---

{
  faqs.length > 0 && (
    <section class="faq container" aria-labelledby={showHeading ? id : undefined} aria-label={showHeading ? undefined : heading}>
      {showHeading && <h2 id={id}>{heading}</h2>}
      {groups.map((g) => (
        <div class="faq__group">
          {g.title && <h2 class="faq__group-title label">{g.title}</h2>}
          <div class="faq__list">
            {g.items.map((f) => (
              <div class="faq__item" id={f.id}>
                <QLevel class="faq__q">{f.question}</QLevel>
                <div class="faq__a" set:html={f.answer} />
              </div>
            ))}
          </div>
        </div>
      ))}
      {more && (
        <p class="faq__more">
          <a href={more.href}>{more.label}</a>
        </p>
      )}
    </section>
  )
}

<style>
  .faq {
    display: grid;
    gap: var(--space-7);
  }

  .faq__group {
    display: grid;
    gap: var(--space-4);
  }

  .faq__group-title {
    font-family: var(--font-label);
    font-size: var(--text-label);
    color: var(--color-text-accent);
  }

  .faq__list {
    display: grid;
  }

  .faq__item {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-block-start: var(--line-thin) solid var(--color-border);
  }

  .faq__item:last-child {
    border-block-end: var(--line-thin) solid var(--color-border);
  }

  .faq__q {
    font-family: var(--font-body);
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-text);
  }

  .faq__a {
    display: grid;
    gap: var(--space-3);
    color: var(--color-text-secondary);
  }

  .faq__a :global(ul) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-inline-start: 1.25em;
  }

  .faq__a :global(strong) {
    color: var(--color-text);
  }

  .faq__item:target .faq__q {
    color: var(--color-text-accent);
  }

  @media (min-width: 60rem) {
    .faq__item {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-8);
    }
  }
</style>
