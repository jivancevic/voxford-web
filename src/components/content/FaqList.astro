---
// Questions and answers as an exclusive accordion: native <details name> +
// <summary>, closed by default, one open at a time (Josip, 2026-11-10; spec ›
// Acceptance). The answers stay in the static HTML, so crawlers and the FAQPage
// JSON-LD see all of them; the caller passes the same Faq[] it puts into that
// JSON-LD. Click, tap, Enter and Space open an item (no hover: it would jump the
// layout and does not exist on touch). A `#<faq id>` link opens its item.
// `grouped` splits them under the FAQ page's section headings.
import { getStrings, type Locale } from '@/i18n';
import type { Faq } from '@/lib/faq';
import { FAQ_GROUPS } from '@/lib/faq-groups';

interface Props {
  lang: Locale;
  faqs: readonly Faq[];
  id: string;
  heading: string;
  /** Show the visible h2 (off on the FAQ page, whose h1 is the heading). */
  showHeading?: boolean;
  grouped?: boolean;
  /** Link to the full FAQ page under a page's block. */
  more?: { href: string; label: string };
}

const { lang, faqs, id, heading, showHeading = true, grouped = false, more } = Astro.props;
const t = getStrings(lang);
const groups = grouped
  ? FAQ_GROUPS.map((g) => ({ key: g, title: t.content.faq.groups[g], items: faqs.filter((f) => f.group === g) })).filter(
      (g) => g.items.length > 0,
    )
  : [{ key: 'all', title: undefined, items: faqs }];
// Questions sit one level under the nearest visible heading.
const QLevel = showHeading || grouped ? 'h3' : 'h2';
---

{
  faqs.length > 0 && (
    <section class="faq container" aria-labelledby={showHeading ? id : undefined} aria-label={showHeading ? undefined : heading}>
      {showHeading && <h2 id={id}>{heading}</h2>}
      {groups.map((g) => (
        <div class="faq__group">
          {g.title && <h2 class="faq__group-title label">{g.title}</h2>}
          <div class="faq__list">
            {g.items.map((f) => (
              <details class="faq__item" id={f.id} name={id}>
                <summary class="faq__summary">
                  <QLevel class="faq__q">{f.question}</QLevel>
                  <span class="faq__icon" aria-hidden="true" />
                </summary>
                <div class="faq__a" set:html={f.answer} />
              </details>
            ))}
          </div>
        </div>
      ))}
      {more && (
        <p class="faq__more">
          <a href={more.href}>{more.label}</a>
        </p>
      )}
    </section>
  )
}

<script>
  // A link to `#<faq id>` (from another page or this one) opens that item;
  // the browser only auto-opens <details> for targets inside the answer.
  function openTarget() {
    // FAQ ids are ASCII slugs, so the hash needs no decoding (a malformed
    // `#%` would make decodeURIComponent throw).
    const id = location.hash.slice(1);
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDetailsElement && target.classList.contains('faq__item')) target.open = true;
  }
  openTarget();
  window.addEventListener('hashchange', openTarget);
</script>

<style>
  .faq {
    display: grid;
    gap: var(--space-7);
  }

  .faq__group {
    display: grid;
    gap: var(--space-4);
  }

  .faq__group-title {
    font-family: var(--font-label);
    font-size: var(--text-label);
    color: var(--color-text-accent);
  }

  .faq__list {
    display: grid;
  }

  .faq__item {
    border-block-start: var(--line-thin) solid var(--color-border);
  }

  .faq__item:last-child {
    border-block-end: var(--line-thin) solid var(--color-border);
  }

  .faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-block-size: 3rem;
    padding-block: var(--space-5);
    list-style: none;
    cursor: pointer;
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font-family: var(--font-body);
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-text);
  }

  /* Only an open item is accent: a deep-linked item that was closed again stays :target. */
  .faq__item[open] .faq__q {
    color: var(--color-text-accent);
  }

  @media (hover: hover) {
    .faq__summary:hover .faq__q {
      color: var(--color-text-accent);
    }
  }

  /* Plus when closed, minus when open: the vertical bar turns flat. */
  .faq__icon {
    position: relative;
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
    border: var(--line-thin) solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 0.75rem;
    block-size: 2px;
    border-radius: var(--radius-pill);
    background: currentColor;
    translate: -50% -50%;
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__icon {
    border-color: var(--color-text-accent);
    color: var(--color-text-accent);
  }

  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
  }

  .faq__a {
    display: grid;
    gap: var(--space-3);
    max-inline-size: var(--measure);
    padding-block-end: var(--space-6);
    color: var(--color-text-secondary);
  }

  .faq__a :global(ul) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-inline-start: 1.25em;
  }

  .faq__a :global(strong) {
    color: var(--color-text);
  }

  /* Smooth open and close where the browser can animate to `auto`; elsewhere it snaps. */
  @media (prefers-reduced-motion: no-preference) {
    .faq__item {
      interpolate-size: allow-keywords;
    }

    .faq__item::details-content {
      block-size: 0;
      overflow: clip;
      /* Room for the focus ring of a link at the edge of an answer. */
      overflow-clip-margin: 0.5rem;
      opacity: 0;
      transition:
        block-size var(--duration-base) var(--ease-out),
        opacity var(--duration-base) var(--ease-out),
        content-visibility var(--duration-base) allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }

    .faq__icon::after {
      transition: rotate var(--duration-base) var(--ease-out);
    }
  }
</style>
