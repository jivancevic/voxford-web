---
// SEAM (ticket E; the props are fixed): the wall of organisations Voxford
// performed for. Reads the `references` collection itself (confirmed rows from
// the KB's posao/klijenti/reference.md, never private clients), so callers
// pass no data. Logos are shown monochrome (`mono` per entry); an organisation
// without a clean official logo shows its name as text; artists Voxford shared
// a stage with are one line of names. Renders nothing while the collection is
// empty, so it never shows a hole.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getStrings, type Locale } from '@/i18n';

export interface Props {
  lang: Locale;
  /** Show at most this many organisations (in `order`; artists not counted). */
  limit?: number;
  /** Override the section heading; `false` renders no heading. */
  heading?: string | false;
  class?: string;
}

const { lang, limit, heading, class: className } = Astro.props;
const t = getStrings(lang);
const all = (await getCollection('references')).sort((a, b) => a.data.order - b.data.order);
const organisations = all.filter((e) => e.data.kind !== 'artist').slice(0, limit);
const artists = all.filter((e) => e.data.kind === 'artist');
const title = heading === false ? undefined : (heading ?? t.videos.references.heading);
---

{
  organisations.length > 0 && (
    <section class:list={['references', className]} aria-labelledby={title ? 'references-heading' : undefined}>
      {title && (
        <h2 class="references__heading" id="references-heading">
          {title}
        </h2>
      )}
      <ul class="references__grid" role="list">
        {organisations.map((e) => (
          <li class="references__item">
            {e.data.logo ? (
              <Image
                src={e.data.logo}
                alt={e.data.name}
                height={96}
                class:list={['references__logo', `references__logo--${e.data.mono}`]}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="references__name">{e.data.name}</span>
            )}
          </li>
        ))}
      </ul>
      {artists.length > 0 && (
        <p class="references__artists">
          <span class="label">{t.videos.references.artists}</span>{' '}
          {artists.map((a, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <span class="references__artist">{a.data.name}</span>
            </>
          ))}
        </p>
      )}
    </section>
  )
}

<style>
  .references {
    display: grid;
    gap: var(--space-6);
  }

  .references__heading {
    font-size: var(--text-title);
  }

  .references__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .references__item {
    display: grid;
    place-items: center;
    min-block-size: 6rem;
    padding: var(--space-4);
    border-block-end: var(--line-thin) solid var(--color-border-subtle);
  }

  .references__logo {
    inline-size: auto;
    max-inline-size: 100%;
    block-size: auto;
    max-block-size: 2.75rem;
    object-fit: contain;
    opacity: 0.78;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  /* One light colour on the dark hall; one dark colour in a light section. */
  .references__logo--silhouette {
    filter: brightness(0) invert(1);
  }

  .references__logo--grayscale {
    filter: grayscale(1) contrast(1.1);
  }

  :global(.surface-light) .references__logo--silhouette {
    filter: brightness(0);
  }

  .references__item:hover .references__logo {
    opacity: 1;
  }

  .references__name {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--text-body);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .references__artists {
    max-inline-size: none;
    color: var(--color-text-secondary);
  }

  .references__artists .label {
    margin-inline-end: var(--space-2);
  }

  .references__artist {
    white-space: nowrap;
    color: var(--color-text);
  }
</style>
