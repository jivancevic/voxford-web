---
// SEAM (ticket E fills it; the props are fixed): the logo wall of
// organisations Voxford performed for. Reads the `references` collection
// itself (confirmed rows only, never private clients), so callers pass no data.
// Renders nothing while the collection is empty, so it never shows a hole.
import { getCollection } from 'astro:content';
import { getStrings, type Locale } from '@/i18n';

export interface Props {
  lang: Locale;
  /** Show at most this many logos (in `order`). */
  limit?: number;
  /** Override the section heading; `false` renders no heading. */
  heading?: string | false;
  class?: string;
}

const { lang, limit, heading, class: className } = Astro.props;
const t = getStrings(lang);
const entries = (await getCollection('references')).sort((a, b) => a.data.order - b.data.order).slice(0, limit);
const title = heading === false ? undefined : (heading ?? t.videos.references.heading);
---

{
  entries.length > 0 && (
    <section class:list={['references', className]} data-stub="references-wall">
      {title && <h2 class="label">{title}</h2>}
      <ul>
        {entries.map((e) => (
          <li>{e.data.name}</li>
        ))}
      </ul>
    </section>
  )
}
