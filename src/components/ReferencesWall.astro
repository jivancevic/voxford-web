---
// SEAM (ticket E; the props are fixed): the wall of organisations Voxford
// performed for. Reads the `references` collection itself (confirmed rows from
// the KB's posao/klijenti/reference.md, never private clients), so callers
// pass no data. Logos are shown monochrome (`mono` per entry); an organisation
// without a clean official logo shows its name as text. The stages Voxford was
// invited onto and the artists it shared them with are tiles (#33): our own
// photo from that stage or with that artist where the entry names one
// (`photo`, a key in src/data/photos.ts), a big name in type otherwise.
// Renders nothing while the collection is empty, so it never shows a hole.
import { getCollection } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import { PHOTOS, type PhotoKey } from '@/data/photos';
import { format, getStrings, type Locale } from '@/i18n';

export interface Props {
  lang: Locale;
  /** Show at most this many organisations (in `order`; stages and artists not counted). */
  limit?: number;
  /** Override the section heading; `false` renders no heading. */
  heading?: string | false;
  class?: string;
}

const { lang, limit, heading, class: className } = Astro.props;
const t = getStrings(lang);
const all = (await getCollection('references')).sort((a, b) => a.data.order - b.data.order);
// Stages and artists are names on their own lines: a stage's logo would read as a client.
const organisations = all.filter((e) => e.data.kind !== 'artist' && e.data.kind !== 'venue').slice(0, limit);

function photoOf(key: string | undefined) {
  if (!key) return undefined;
  if (!(key in PHOTOS)) throw new Error(`references: unknown photo "${key}" (not a key in src/data/photos.ts)`);
  const p = PHOTOS[key as PhotoKey];
  return {
    src: p.src,
    alt: p.alt[lang],
    label: 'label' in p ? p.label[lang] : undefined,
    credit: 'credit' in p ? p.credit : undefined,
  };
}

/** Responsive widths up to the file's own (some stage photos are small), never upscaled. */
const widthsFor = (width: number) => [...[360, 540, 720, 960, 1200].filter((w) => w < width), Math.min(width, 1440)];

// Per group: the photo tiles in one row, the names in type in a lower row under them; `order` within each.
const groupOf = (id: string, label: string, kind: 'venue' | 'artist') => {
  const entries = all.filter((e) => e.data.kind === kind).map((e) => ({ name: e.data.name, photo: photoOf(e.data.photo) }));
  return {
    id,
    label,
    photos: entries.flatMap((e) => (e.photo ? [{ name: e.name, photo: e.photo }] : [])),
    names: entries.filter((e) => !e.photo).map((e) => e.name),
  };
};
const groups = [
  groupOf('stages', t.videos.references.stages, 'venue'),
  groupOf('artists', t.videos.references.artists, 'artist'),
].filter((g) => g.photos.length + g.names.length > 0);
const title = heading === false ? undefined : (heading ?? t.videos.references.heading);
---

{
  organisations.length > 0 && (
    <section class:list={['references', className]} aria-labelledby={title ? 'references-heading' : undefined}>
      {title && (
        <h2 class="references__heading" id="references-heading">
          {title}
        </h2>
      )}
      <ul class="references__grid" role="list">
        {organisations.map((e) => (
          <li class="references__item">
            {e.data.logo ? (
              <Image
                src={e.data.logo}
                alt={e.data.name}
                height={96}
                class:list={['references__logo', `references__logo--${e.data.mono}`]}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="references__name">
                {/* "Bruketa&Žinić&Grey" has no spaces: let it break after each "&" inside its cell. */}
                {e.data.name.split('&').map((part, i) => (
                  <>
                    {i > 0 && (
                      <>
                        &amp;
                        <wbr />
                      </>
                    )}
                    {part}
                  </>
                ))}
              </span>
            )}
          </li>
        ))}
      </ul>
      {groups.map((group) => (
        <div class="references__group">
          <h3 class="label references__group-label" id={`references-${group.id}`}>
            {group.label}
          </h3>
          {group.photos.length > 0 && (
            <ul class="references__photos" role="list" aria-labelledby={`references-${group.id}`}>
              {group.photos.map((tile) => (
                <li class="tile tile--photo">
                  <figure class="tile__figure">
                    <Picture
                      src={tile.photo.src}
                      alt={tile.photo.alt}
                      formats={['avif', 'webp']}
                      widths={widthsFor(tile.photo.src.width)}
                      sizes="(width < 48rem) calc(100vw - 2rem), 38rem"
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption class="tile__text">
                      <span class="tile__name">{tile.name}</span>
                      {tile.photo.label && <span class="label tile__label">{tile.photo.label}</span>}
                      {tile.photo.credit && (
                        <span class="tile__credit">{format(t.content.photoCredit, { credit: tile.photo.credit })}</span>
                      )}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          )}
          {group.names.length > 0 && (
            <ul class="references__names" role="list" aria-labelledby={`references-${group.id}`}>
              {group.names.map((name) => (
                <li class="tile tile--type">
                  <span class="tile__name">{name}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </section>
  )
}

<style>
  .references {
    display: grid;
    gap: var(--space-6);
  }

  .references__heading {
    font-size: var(--text-title);
  }

  .references__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .references__item {
    display: grid;
    place-items: center;
    min-block-size: 6rem;
    padding: var(--space-4);
    border-block-end: var(--line-thin) solid var(--color-border-subtle);
  }

  .references__logo {
    inline-size: auto;
    max-inline-size: 100%;
    block-size: auto;
    max-block-size: 2.75rem;
    object-fit: contain;
    opacity: 0.78;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  /* One light colour on the dark hall; one dark colour in a light section. */
  .references__logo--silhouette {
    filter: brightness(0) invert(1);
  }

  .references__logo--grayscale {
    filter: grayscale(1) contrast(1.1);
  }

  :global(.surface-light) .references__logo--silhouette {
    filter: brightness(0);
  }

  .references__item:hover .references__logo {
    opacity: 1;
  }

  .references__name {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--text-body);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    text-wrap: balance;
    color: var(--color-text-secondary);
  }

  /* ---------- Stages and artists: tiles ---------- */

  .references__group {
    display: grid;
    gap: var(--space-4);
  }

  .references__group-label {
    color: var(--color-text-secondary);
  }

  /* Photos: two or three wide frames per row. */
  .references__photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Names: flex, not grid, so the tiles grow to close each row without holes. */
  .references__names {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: grid;
    max-inline-size: none;
    overflow: clip;
    border-radius: var(--radius-card);
  }

  .tile--photo {
    aspect-ratio: 2 / 1;
    background: var(--color-bg-raised);
  }

  .tile--type {
    flex: 1 1 13rem;
    align-items: end;
    min-block-size: 7rem;
    padding: var(--space-5);
    border: var(--line-thin) solid var(--color-border);
    isolation: isolate;
  }

  /* Stage light from the top edge, the brand gradient as a thin line. */
  .tile--type::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    block-size: calc(2 * var(--line-thin));
    background: var(--gradient-light);
  }

  .tile__figure {
    position: relative;
    display: grid;
    margin: 0;
    block-size: 100%;
  }

  .tile__figure :global(picture) {
    display: contents;
  }

  .tile__figure :global(img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .tile__figure::after {
    content: '';
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(to top, var(--color-scrim), transparent);
    pointer-events: none;
  }

  .tile__text {
    position: relative;
    z-index: 1;
    align-self: end;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
    color: var(--color-text-on-photo);
  }

  .tile__name {
    font-family: var(--font-headline);
    font-size: var(--text-heading);
    font-weight: 800;
    line-height: var(--leading-heading);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .tile__label,
  .tile__credit {
    color: color-mix(in oklab, var(--color-text-on-photo) 82%, transparent);
  }

  .tile__credit {
    font-size: var(--text-caption);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile__figure :global(img) {
      transition: transform 900ms var(--ease-out);
    }

    .tile--photo:hover .tile__figure :global(img) {
      transform: scale(1.04);
    }
  }

  @media (width < 48rem) {
    .tile--photo {
      aspect-ratio: 3 / 2;
    }

    .tile--type {
      flex-basis: 9rem;
      min-block-size: 5.5rem;
      padding: var(--space-4);
    }

    .tile__name {
      font-size: var(--text-lead);
    }
  }
</style>
