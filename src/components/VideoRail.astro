---
// SEAM (ticket E; the props are fixed): a horizontal rail of videos.
// `top` = the curated top videos (the `videos` collection, each with a watch
// page); `reels` = the latest reels from the daily sync (read at build time,
// src/lib/reels.ts). Reads its own data, so callers pass no data. Renders
// nothing while there is nothing to show (no reels when the feed is down).
// `inline` (the home page, #33): top videos play in their card instead of
// opening the watch page, and cards grow a little under the pointer.
import { getCollection } from 'astro:content';
import ReelCard from '@/components/ReelCard.astro';
import VideoCard from '@/components/VideoCard.astro';
import { getStrings, type Locale } from '@/i18n';
import { railCardSizes } from '@/lib/rail-sizes';
import { loadReels } from '@/lib/reels';

export interface Props {
  lang: Locale;
  source?: 'top' | 'reels';
  /** Show at most this many videos. */
  limit?: number;
  /** Override the section heading; `false` renders no heading. */
  heading?: string | false;
  /** Play top videos in place and grow cards on hover (reels always play in place). */
  inline?: boolean;
  class?: string;
}

const { lang, source = 'top', limit, heading, inline = false, class: className } = Astro.props;
const t = getStrings(lang);
const top = source === 'top' ? (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order).slice(0, limit) : [];
const reels = source === 'reels' ? (await loadReels(Astro.site)).slice(0, limit) : [];
const count = top.length + reels.length;
const cardSizes = railCardSizes(count);
const defaultHeading = source === 'top' ? t.videos.rail.heading : t.videos.rail.reelsHeading;
const title = heading === false ? undefined : (heading ?? defaultHeading);
const headingId = `video-rail-${source}`;
---

{
  count > 0 && (
    <section
      class:list={['video-rail', className]}
      data-source={source}
      data-inline={inline ? '' : undefined}
      aria-labelledby={title ? headingId : undefined}
    >
      {title && (
        <h2 class="video-rail__heading" id={headingId}>
          {title}
        </h2>
      )}
      <ul class="video-rail__list" role="list">
        {top.map((video, i) => (
          <li>
            <VideoCard
              lang={lang}
              video={video}
              number={i + 1}
              sizes={cardSizes}
              play={inline ? 'inline' : 'page'}
            />
          </li>
        ))}
        {reels.map((reel) => (
          <li>
            <ReelCard lang={lang} reel={reel} sizes={cardSizes} />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .video-rail {
    display: grid;
    gap: var(--space-5);
  }

  .video-rail__heading {
    font-size: var(--text-title);
  }

  /* A row that scrolls sideways on small screens and fits on wide ones. The
     posters' `sizes` (src/lib/rail-sizes.ts) mirrors these columns and gap. */
  .video-rail__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(11rem, 15rem);
    gap: var(--space-5);
    margin: 0;
    padding: 0 0 var(--space-3);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .video-rail__list > li {
    scroll-snap-align: start;
    max-inline-size: none;
  }

  /* Hover growth: the list scrolls sideways, which clips both axes, so an
     inline rail keeps a margin of room around the cards for the grown frame. */
  .video-rail[data-inline] .video-rail__list {
    --grow-room: var(--space-4);
    padding: var(--grow-room) var(--grow-room) var(--space-3);
    margin-inline: calc(-1 * var(--grow-room));
    margin-block-start: calc(-1 * var(--grow-room));
    scroll-padding-inline: var(--grow-room);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .video-rail[data-inline] :global(:is(.video-card__frame, .reel__frame)) {
      transition: transform var(--duration-base) var(--ease-out);
    }

    .video-rail[data-inline] li:is(:hover, :focus-within) :global(:is(.video-card__frame, .reel__frame)) {
      transform: scale(1.05);
    }
  }
</style>
