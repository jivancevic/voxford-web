---
// The layout shell every page renders in: <head> (meta, canonical, hreflang,
// Open Graph, JSON-LD, fonts), skip link, header, <main>, footer.
// Pages pass `page` (a key from src/i18n/routes.ts) and get correct
// alternates and the language switch for free; a dynamic page (a video watch
// page) passes `alternates` itself.
import { Font, getImage } from 'astro:assets';
import { SITE_INDEXABLE } from 'astro:env/server';
import JsonLd from '@/components/JsonLd.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { PHOTOS, SHARE_PHOTO, type PhotoKey } from '@/data/photos';
import { format, getStrings, LOCALE_META, LOCALES, type Locale } from '@/i18n';
import { alternatesFor, type PageKey } from '@/i18n/routes';
import { musicGroupJsonLd, webSiteJsonLd, type JsonLdNode } from '@/lib/jsonld';
import { canonicalUrl, hreflangAlternates, robotsMeta } from '@/lib/seo';
import '@/styles/global.css';
import { THEME_COLOR } from '@/styles/theme';

interface Props {
  lang: Locale;
  /** Route-table key of this page. Omit only for pages outside the table (404, watch pages). */
  page?: PageKey;
  /** Every language version of this page; defaults to the route table's paths for `page`. */
  alternates?: Record<Locale, string>;
  /** <title> without the site suffix. */
  title: string;
  description: string;
  /** Social preview photo; defaults to the share photo. */
  ogPhoto?: PhotoKey;
  /** A ready 1200×630 share image outside photos.ts (a video's card, src/pages/og/), by path, with its alt text; wins over `ogPhoto`. */
  ogImage?: { path: string; alt: string };
  /** Page-level JSON-LD nodes, added after the site-wide MusicGroup and WebSite. */
  jsonLd?: readonly JsonLdNode[];
  /** Force noindex on this page even in production (e.g. an empty concerts page). */
  noindex?: boolean;
}

const { lang, page, title, description, ogPhoto = SHARE_PHOTO, jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site!;
const t = getStrings(lang);

const alternates = Astro.props.alternates ?? (page ? alternatesFor(page) : undefined);
const canonical = canonicalUrl(site, alternates?.[lang] ?? Astro.url.pathname);
const hreflang = alternates ? hreflangAlternates(site, alternates) : [];
const fullTitle = page === 'home' ? title : format(t.common.meta.titleTemplate, { title });

// 1200×630, or as wide as the photo allows at the same ratio (images are never upscaled).
const photoSrc = PHOTOS[ogPhoto].src;
const photoWidth = Math.min(1200, photoSrc.width);
const photoHeight = Math.round((photoWidth * 630) / 1200);
const photo = await getImage({ src: photoSrc, width: photoWidth, height: photoHeight, fit: 'cover', format: 'jpg' });
const photoImage = new URL(photo.src, site).href;
const ogImage = Astro.props.ogImage ? new URL(Astro.props.ogImage.path, site).href : photoImage;
const ogImageAlt = Astro.props.ogImage?.alt ?? PHOTOS[ogPhoto].alt[lang];
const [ogWidth, ogHeight] = Astro.props.ogImage ? [1200, 630] : [photoWidth, photoHeight];

const nodes: JsonLdNode[] = [
  musicGroupJsonLd(site, lang, { description: t.common.meta.defaultDescription, image: photoImage }),
  webSiteJsonLd(site, lang),
  ...jsonLd,
];
---

<!doctype html>
<html lang={LOCALE_META[lang].htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsMeta(SITE_INDEXABLE, noindex)} />
    <link rel="canonical" href={canonical} />
    {hreflang.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.common.meta.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={LOCALE_META[lang].ogLocale} />
    {LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Icons: written by scripts/icons.mjs. The ICO says 32x32 so browsers that read SVG pick the SVG. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="application-name" content={t.common.meta.siteName} />
    <meta name="apple-mobile-web-app-title" content={t.common.meta.siteName} />

    <Font cssVariable="--font-instrument-sans" preload />
    <Font cssVariable="--font-big-shoulders" />
    <Font cssVariable="--font-staubach" />
    <Font cssVariable="--font-jura" />

    <JsonLd nodes={nodes} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.a11y.skipToContent}</a>
    <SiteHeader lang={lang} page={page} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
