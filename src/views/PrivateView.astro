---
// Private celebrations (ticket C): surprise, a concert for the guests, the full concert; private
// clients are never named. Layout and JSON-LD: src/components/content/EventPage.astro.
import EventPage from '@/components/content/EventPage.astro';
import type { Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<EventPage lang={lang} page="private" type="private" heroPhoto="shootArmchair" bandPhoto="shootGlass" />
