---
// The 404 page in one language, with the other language's line beside it.
// Workers assets serve the nearest 404.html for a missing path (wrangler.jsonc
// › not_found_handling), so /hr/… gets dist/hr/404.html and everything else
// the root one, which is English.
import Pill from '@/components/Pill.astro';
import { getStrings, type Locale } from '@/i18n';
import { LOCALES } from '@/i18n/locales';
import { pathFor } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const other = LOCALES.find((l) => l !== lang)!;
const t = getStrings(lang);
const nf = t.common.notFound;
const nfOther = getStrings(other).common.notFound;
---

<BaseLayout lang={lang} title={nf.title} description={t.common.meta.defaultDescription} noindex>
  <section class="nf container">
    <p class="numeral" aria-hidden="true">404</p>
    <h1>{nf.title}</h1>
    <p class="lead">{nf.body}</p>
    <p class="lead" lang={other}>{nfOther.title}. {nfOther.body}</p>
    <div class="nf__actions">
      <Pill href={pathFor('home', lang)}>{nf.back}</Pill>
      <Pill href={pathFor('home', other)} variant="ghost" lang={other}>{nfOther.back}</Pill>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-block: var(--space-9);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
