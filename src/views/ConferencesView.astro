---
// Conferences & corporate events (ticket C): the primary SEO/GEO page. It
// answers "music for a conference / corporate event in Zagreb, Croatia, the
// region" in static HTML: who, set lengths, logistics, references, FAQ.
// JSON-LD: BreadcrumbList, one Service per package, FAQPage.
import ReferencesWall from '@/components/ReferencesWall.astro';
import VideoRail from '@/components/VideoRail.astro';
import ContentHero from '@/components/content/ContentHero.astro';
import CreditedPhoto from '@/components/content/CreditedPhoto.astro';
import EndCta from '@/components/content/EndCta.astro';
import FactList from '@/components/content/FactList.astro';
import FaqList from '@/components/content/FaqList.astro';
import NamedList from '@/components/content/NamedList.astro';
import PackageSection from '@/components/content/PackageSection.astro';
import PageFlow from '@/components/content/PageFlow.astro';
import Programme from '@/components/content/Programme.astro';
import Prose from '@/components/content/Prose.astro';
import { getStrings, type Locale } from '@/i18n';
import { pathFor, type PageKey } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fillFacts } from '@/lib/copy';
import { getFaqs } from '@/lib/faq';
import { faqPageJsonLd } from '@/lib/jsonld';
import { breadcrumbsFor, loadPage } from '@/lib/page';
import { servicesFor } from '@/lib/services';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const page: PageKey = 'conferences';
const site = Astro.site!;
const copy = await loadPage(page, lang);
const t = getStrings(lang);
const c = t.content.conferences;
const faqs = await getFaqs(lang, page);
const prefill = { type: 'conference' } as const;
---

<BaseLayout
  lang={lang}
  page={page}
  title={copy.data.title}
  description={fillFacts(copy.data.description, lang)}
  ogPhoto="unisportStage"
  jsonLd={[breadcrumbsFor(site, page, lang), ...servicesFor(site, lang, page, c.serviceType), faqPageJsonLd(faqs)]}
>
  <PageFlow>
    <ContentHero
      lang={lang}
      heading={copy.data.heading}
      lead={fillFacts(c.lead, lang)}
      photo="unisportStage"
      prefill={prefill}
      secondary={{ href: '#packages-heading', label: t.content.seePackages }}
    />
    <FactList lang={lang} label={t.content.factsLabel} facts={c.facts} />
    <Prose lang={lang} html={copy.rendered?.html ?? ''} />
    <Programme lang={lang} id="programme" heading={c.programmeHeading} intro={c.programmeIntro} moments={c.moments} />
    <div class="container band">
      <CreditedPhoto photo="hakEsplanade" lang={lang} sizes="(min-width: 76rem) 76rem, 100vw" />
    </div>
    <div class="references-block">
      <NamedList id="references" heading={c.referencesHeading} intro={c.referencesIntro} items={c.references} />
      <ReferencesWall lang={lang} heading={false} class="container" />
    </div>
    <PackageSection lang={lang} type="conference" />
    <FaqList lang={lang} id="faq" heading={t.content.faq.heading} faqs={faqs} more={{ href: pathFor('faq', lang), label: t.content.faq.all }} />
    <VideoRail lang={lang} limit={4} class="container" />
    <EndCta lang={lang} prefill={prefill} />
  </PageFlow>
</BaseLayout>

<style>
  .band :global(.credited-photo) {
    --photo-ratio: 16 / 9;
  }

  .references-block {
    display: grid;
    gap: var(--space-7);
  }
</style>
