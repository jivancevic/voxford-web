---
// View for the `concerts` page (owner: ticket C). Both language routes
// render this file; replace the placeholder with the real page.
import PagePlaceholder from '@/components/PagePlaceholder.astro';
import type { Locale } from '@/i18n';
import type { PageKey } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getUpcomingConcerts } from '@/lib/concerts';
import { breadcrumbsFor, loadPage } from '@/lib/page';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const page: PageKey = 'concerts';
const copy = await loadPage(page, lang);
// Hidden when empty: noindex, and the footer and sitemap leave it out.
const upcoming = await getUpcomingConcerts();
---

<BaseLayout
  lang={lang}
  page={page}
  title={copy.data.title}
  description={copy.data.description}
  jsonLd={[breadcrumbsFor(Astro.site!, page, lang)]} noindex={upcoming.length === 0}
>
  <PagePlaceholder lang={lang} heading={copy.data.heading} prefill={{ type: 'concert' }} />
</BaseLayout>
