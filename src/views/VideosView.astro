---
// View for the `videos` page (owner: ticket E): the top videos as a numbered
// programme, each linking to its watch page; the latest videos (the reels from
// the daily sync and the newest YouTube uploads, each row absent when its feed
// is); every network we are on (#41); the reference wall, then the inquiry.
// All text is static HTML; the loops and the players only enhance it.
import { getCollection, render } from 'astro:content';
import InquiryCTA from '@/components/InquiryCTA.astro';
import ReferencesWall from '@/components/ReferencesWall.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import VideoCard from '@/components/VideoCard.astro';
import VideoRail from '@/components/VideoRail.astro';
import YouTubeRail from '@/components/YouTubeRail.astro';
import { GROUP, PROFILES } from '@/data/site-facts';
import { format, getStrings, type Locale } from '@/i18n';
import type { PageKey } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbsFor, loadPage } from '@/lib/page';
import { loadReels } from '@/lib/reels';
import { loadYouTubeUploads } from '@/lib/youtube';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const page: PageKey = 'videos';
const t = getStrings(lang);
const copy = await loadPage(page, lang);
const { Content } = await render(copy);
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
const hasReels = (await loadReels(Astro.site)).length > 0;
const hasYouTube = (await loadYouTubeUploads()).length > 0;
---

<BaseLayout
  lang={lang}
  page={page}
  title={copy.data.title}
  description={copy.data.description}
  jsonLd={[breadcrumbsFor(Astro.site!, page, lang)]}
>
  <header class="videos-intro container">
    <h1>{copy.data.heading}</h1>
    <span class="light-line videos-intro__line" aria-hidden="true"></span>
    <div class="lead videos-intro__lead"><Content /></div>
  </header>

  <section class="videos-top container" aria-labelledby="videos-top-heading">
    <h2 class="label videos-section-label" id="videos-top-heading">{t.videos.page.topHeading}</h2>
    <ol class="videos-top__grid" role="list">
      {
        videos.map((video, i) => (
          <li class:list={['videos-top__item', { 'videos-top__item--lead': i === 0 }]}>
            <VideoCard
              lang={lang}
              video={video}
              number={i + 1}
              headingLevel={3}
              priority={i === 0}
              sizes={i === 0 ? '(min-width: 64rem) 24rem, 90vw' : '(min-width: 64rem) 15rem, 45vw'}
            />
          </li>
        ))
      }
    </ol>
  </section>

  {
    (hasReels || hasYouTube) && (
      <section class="videos-latest container" aria-labelledby="videos-latest-heading">
        <div class="videos-latest__head">
          <h2 class="label videos-section-label" id="videos-latest-heading">
            {t.videos.page.latestHeading}
          </h2>
          <p class="videos-latest__lead">{t.videos.page.latestLead}</p>
        </div>
        {hasReels && (
          <div class="videos-latest__row" aria-labelledby="videos-reels-heading" role="group">
            <div class="videos-latest__row-head">
              <h3 class="videos-latest__row-heading" id="videos-reels-heading">
                {t.videos.page.reelsHeading}
              </h3>
              <p class="videos-latest__row-lead">{t.videos.page.reelsLead}</p>
            </div>
            <VideoRail lang={lang} source="reels" heading={false} />
            <p>
              <a href={PROFILES.instagram} rel="noopener">
                {format(t.videos.page.follow, { handle: GROUP.handle })}
              </a>
            </p>
          </div>
        )}
        {hasYouTube && (
          <div class="videos-latest__row" aria-labelledby="videos-youtube-heading" role="group">
            <h3 class="videos-latest__row-heading" id="videos-youtube-heading">
              {t.videos.page.youtubeHeading}
            </h3>
            <YouTubeRail lang={lang} />
          </div>
        )}
      </section>
    )
  }

  <section class="videos-social container" aria-labelledby="videos-social-heading">
    <div class="videos-social__head">
      <h2 class="videos-social__heading" id="videos-social-heading">{t.videos.social.heading}</h2>
      <p class="videos-social__lead">{t.videos.social.lead}</p>
    </div>
    <SocialLinks />
  </section>

  <ReferencesWall lang={lang} class="videos-references container" />

  <section class="videos-closing container">
    <span class="light-line videos-closing__line" aria-hidden="true"></span>
    <p class="videos-closing__text">{t.videos.page.closing}</p>
    <InquiryCTA lang={lang} />
  </section>
</BaseLayout>

<style>
  .videos-intro {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-block: var(--space-9) var(--space-7);
  }

  .videos-intro__line {
    inline-size: min(16rem, 60%);
  }

  .videos-intro__lead :global(p) {
    max-inline-size: 52ch;
  }

  .videos-section-label {
    margin-block-end: var(--space-5);
  }

  /* The programme: the most-watched video leads, the rest follow in a row. */
  .videos-top__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .videos-top__item {
    max-inline-size: none;
  }

  .videos-top__item--lead {
    grid-column: 1 / -1;
    max-inline-size: 24rem;
  }

  @media (min-width: 48rem) {
    .videos-top__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .videos-top__grid {
      grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
      align-items: end;
    }

    .videos-top__item--lead {
      grid-column: auto;
      max-inline-size: none;
    }
  }

  .videos-latest {
    display: grid;
    gap: var(--space-7);
    padding-block-start: var(--section-gap);
  }

  .videos-latest__head,
  .videos-latest__row-head {
    display: grid;
    gap: var(--space-2);
  }

  .videos-latest__head .videos-section-label {
    margin: 0;
  }

  .videos-latest__lead,
  .videos-latest__row-lead {
    color: var(--color-text-secondary);
  }

  .videos-latest__row {
    display: grid;
    gap: var(--space-5);
  }

  .videos-latest__row-heading {
    font-size: var(--text-lead);
  }

  .videos-social {
    display: grid;
    gap: var(--space-6);
    padding-block-start: var(--section-gap);
  }

  .videos-social__head {
    display: grid;
    gap: var(--space-3);
  }

  .videos-social__heading {
    font-size: var(--text-heading);
  }

  .videos-social__lead {
    max-inline-size: 52ch;
    color: var(--color-text-secondary);
  }

  /* :global: the class sits on ReferencesWall's root, outside this view's scope. */
  .videos-intro ~ :global(.videos-references) {
    padding-block-start: var(--section-gap);
  }

  .videos-closing {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-block: var(--section-gap);
  }

  .videos-closing__line {
    inline-size: min(10rem, 40%);
  }

  .videos-closing__text {
    font-family: var(--font-headline);
    font-weight: 800;
    font-size: var(--text-heading);
    line-height: var(--leading-heading);
    text-transform: uppercase;
  }
</style>
