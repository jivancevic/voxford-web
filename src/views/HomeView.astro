---
// View for the `home` page (owner: ticket B): the scroll experience.
// Brief, grammar, feeling curve and score: docs/home/BRIEF.md. Motion:
// src/scripts/home-stage.ts. Every word and every portrait is in the static
// HTML; the script only moves light around what is already here.
import { Picture } from 'astro:assets';
import carolM4a from '@/assets/audio/carol-chord.m4a?url';
import carolWebm from '@/assets/audio/carol-chord.webm?url';
import AvailabilityCheck from '@/components/AvailabilityCheck.astro';
import ConcertList from '@/components/content/ConcertList.astro';
import Crest from '@/components/Crest.astro';
import InquiryCTA from '@/components/InquiryCTA.astro';
import Photo from '@/components/Photo.astro';
import Pill from '@/components/Pill.astro';
import ReferencesWall from '@/components/ReferencesWall.astro';
import VideoRail from '@/components/VideoRail.astro';
import { HERO_PLANES, PORTRAITS } from '@/data/photos';
import { GROUP, MEMBERS, NUMBERS, PACKAGES, SIGNATURE_VIDEO } from '@/data/site-facts';
import { format, getStrings, type Locale } from '@/i18n';
import { pathFor, type PageKey } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getUpcomingConcerts } from '@/lib/concerts';
import { loadPage } from '@/lib/page';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const page: PageKey = 'home';
const copy = await loadPage(page, lang);
const t = getStrings(lang);
const h = t.home;

const shortest = Math.min(...PACKAGES.map((p) => p.minutes.min ?? p.minutes.max));
const otherRooms = (['weddings', 'advent'] as const).map((key) => ({
  key,
  href: pathFor(key, lang),
  name: t.common.nav[key],
  line: h.rooms[key],
}));
// The next public concerts (#33) in one sideways row (#53): up to eight, a
// season's worth; the rest are on the concerts page. The block hides when
// nothing is upcoming.
const nextConcerts = (await getUpcomingConcerts()).slice(0, 8);
const portraitCredit = [...new Set(Object.values(PORTRAITS).map((p) => p.credit))].join(', ');
const [mailBefore = '', mailAfter = ''] = h.encore.mail.split('{email}');
---

<BaseLayout lang={lang} page={page} title={copy.data.title} description={copy.data.description}>
  <!-- 1 · Curiosity: the hall from the pit, in depth planes (parallax on a sticky stage) -->
  <section id="hero" class="hero" data-sc-act="pin" style="--span: 1.7" aria-labelledby="home-title">
    <div class="hero__stage" data-sc-stage>
      <div class="hero__scene">
        <Picture
          src={HERO_PLANES.far}
          alt=""
          class="hero__plane hero__far"
          formats={['avif', 'webp']}
          widths={[480, 800]}
          sizes="(width < 48rem) 135vw, (orientation: portrait) 135vw, max(100vw, 150svh)"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero__haze" aria-hidden="true"></div>
        {/* A soft back-light around the five (#67, #74), under the singers. */}
        <Picture
          src={HERO_PLANES.rim}
          alt=""
          class="hero__plane hero__rim"
          fallbackFormat="webp"
          formats={['avif', 'webp']}
          widths={[640, 960, 1280]}
          sizes="(width < 48rem) 135vw, (orientation: portrait) 135vw, max(100vw, 150svh)"
          loading="eager"
          fetchpriority="low"
          decoding="async"
        />
        <Picture
          src={HERO_PLANES.subject}
          alt={HERO_PLANES.alt[lang]}
          class="hero__plane hero__subject"
          fallbackFormat="webp"
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1800]}
          sizes="(width < 48rem) 135vw, (orientation: portrait) 135vw, max(100vw, 150svh)"
          loading="eager"
          decoding="async"
        />
        <Picture
          src={HERO_PLANES.front}
          alt=""
          class="hero__plane hero__front"
          fallbackFormat="webp"
          formats={['avif', 'webp']}
          widths={[600, 1000]}
          sizes="(width < 48rem) 135vw, (orientation: portrait) 135vw, max(100vw, 150svh)"
          loading="eager"
          decoding="async"
        />
      </div>

      {/* The display line is the brand line (#31); the hidden lead keeps the H1
           saying who Voxford is for search and screen readers. */}
      <h1 id="home-title" class="hero__title container" data-sc-copy>
        <span class="visually-hidden">{format(h.hero.titleLead, { group: GROUP.disambiguation[lang] })}</span>{' '}
        {copy.data.heading}
      </h1>

      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__copy container">
        <p class="hero__lead" data-sc-copy>{format(h.hero.lead, { group: GROUP.disambiguation[lang] })}</p>
        <div class="hero__actions">
          <AvailabilityCheck lang={lang} class="hero__availability" />
          <Pill href="#chord" variant="ghost">{h.hero.chordLink}</Pill>
        </div>
      </div>
      <p class="hero__caption label" data-sc-copy>
        {HERO_PLANES.label[lang]} · {format(h.hero.photoCredit, { credit: HERO_PLANES.credit })}
      </p>
    </div>
  </section>

  <!-- 2 · Hush: authored silence before the peak (flow) -->
  <section class="hush" data-sc-act="flow">
    <p class="hush__line container" data-sc-in>{h.hush.line}</p>
  </section>

  <!-- 3 · Awe, the peak: one press plays Carol and the five voices light as they enter (pin + bespoke) -->
  <section
    id="chord"
    class="chord"
    data-sc-act="pin"
    style={`--span: 2.4; --voices: ${MEMBERS.length}`}
    data-chord aria-labelledby="chord-title">
    <div class="chord__stage" data-sc-stage>
      <div class="chord__glow" aria-hidden="true"></div>
      <header class="chord__head container">
        <h2 id="chord-title">{h.chord.heading}</h2>
        <p class="chord__hint chord__hint--motion" data-sc-copy>{h.chord.hint}</p>
        <p class="chord__hint chord__hint--still">{h.chord.hintStill}</p>
        <span hidden data-chord-src={carolWebm} data-chord-type="audio/webm; codecs=opus"></span>
        <span hidden data-chord-src={carolM4a} data-chord-type="audio/mp4; codecs=mp4a.40.2"></span>
        <!-- Hidden until the script finds a source the browser can play; it plays only on press.
             It sits under the heading, off every portrait (#77). -->
        <Pill
          class="chord__play"
          hidden
          data-chord-play
          data-label-play={h.chord.play}
          data-label-pause={h.chord.pause}
          data-label-resume={h.chord.resume}
          data-label-replay={h.chord.replay}>
          <svg class="chord__icon chord__icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.2v13.6L18.6 12z" /></svg>
          <svg class="chord__icon chord__icon--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 5h4v14h-4zM13.5 5h4v14h-4z" /></svg>
          <span data-chord-play-label>{h.chord.play}</span>
        </Pill>
      </header>

      <div class="chord__ensemble container">
        <ol class="chord__voices" aria-label={h.chord.voicesLabel}>
          {
            MEMBERS.map((m, i) => (
              <li style={`--i: ${i}`}>
                <div class="voice" data-voice={m.key} data-lit="true" data-caption={`${m.givenName} · ${m.voice[lang]}`}>
                  <span class="voice__beam" aria-hidden="true" />
                  <span class="voice__frame">
                    <Picture
                      src={PORTRAITS[m.key].src}
                      alt=""
                      formats={['avif', 'webp']}
                      widths={[200, 320, 480, 640]}
                      sizes="(width < 64rem) and (orientation: portrait) min(30vw, 12rem), (width < 48rem) 19vw, min(15rem, 17vw)"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="voice__shade" aria-hidden="true" />
                    <span class="voice__wash" aria-hidden="true" />
                  </span>
                  <span class="voice__name display">{m.givenName}</span>
                  <span class="voice__part label">{m.voice[lang]}</span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="chord__foot container">
        <span class="light-line chord__line" aria-hidden="true"></span>
        <p class="chord__caption label" aria-hidden="true" data-chord-caption></p>
        <p class="chord__resolve" data-sc-copy>{format(h.chord.resolve, { views: NUMBERS.carolViews.display })}</p>
        <p class="chord__credit label">{format(h.chord.credit, { credit: portraitCredit })}</p>
      </div>
    </div>
  </section>

  <!-- 4 · Pride: the number under a sweep of light, paired with the videos (reveal) -->
  <section class="proof" data-sc-act="flow">
    <div class="proof__grid container">
      <div class="proof__figure" data-sc-in>
        <p class="numeral proof__num">{NUMBERS.views.display}</p>
        <p class="label">{NUMBERS.views.label[lang]}</p>
      </div>
      <div class="proof__copy" data-sc-in>
        <h2>{h.proof.heading}</h2>
        <p>
          {
            format(h.proof.body, {
              followers: NUMBERS.followers.display,
              views: NUMBERS.views.display,
              carol: NUMBERS.carolViews.display,
            })
          }
        </p>
        <Pill href={SIGNATURE_VIDEO.url} variant="ghost" rel="noopener" target="_blank">{h.proof.watch}</Pill>
      </div>
    </div>
    <VideoRail lang={lang} inline class="proof__rail container" />
    <!-- The newest reels from the daily sync, played in place; absent until the feed has run. -->
    <VideoRail lang={lang} source="reels" limit={4} inline class="proof__reels container" />
  </section>

  <!-- 4b · Live: the next public concerts, where the proof turns into a date (flow) -->
  {
    nextConcerts.length > 0 && (
      <section class="live container" data-sc-act="flow" aria-labelledby="live-title">
        <div class="live__head" data-sc-in>
          <h2 id="live-title">{h.concerts.heading}</h2>
          <p class="live__lead">{h.concerts.lead}</p>
        </div>
        <ConcertList lang={lang} concerts={nextConcerts} level="h3" layout="row" labelledby="live-title" />
        <a class="live__all arrow-link" href={pathFor('concerts', lang)}>
          {h.concerts.all}
        </a>
      </section>
    )
  }

  <!-- 5 · Recognition: house lights up; the rooms Voxford is booked for (flow + parallax media) -->
  <section class="rooms surface-light" data-sc-act="flow" aria-labelledby="rooms-title">
    <div class="rooms__grid container">
      <div class="rooms__lead" data-sc-in>
        <h2 id="rooms-title">{h.rooms.heading}</h2>
        <p class="lead">{format(h.rooms.body, { shortest })}</p>
        <p class="rooms__travel">{t.common.footer.travel}</p>
        <div class="rooms__actions">
          <a class="rooms__primary" href={pathFor('conferences', lang)}>
            {h.rooms.conferencesLink}<span aria-hidden="true">&nbsp;→</span>
          </a>
          <InquiryCTA lang={lang} prefill={{ type: 'conference' }} variant="ghost" />
        </div>
      </div>
      <Photo
        photo="hakEsplanade"
        lang={lang}
        class="rooms__media"
        sizes="(width < 60rem) 100vw, 55vw"
        widths={[480, 768, 1080, 1440]}
        showLabel
      />
    </div>

    <div class="rooms__more container">
      <h3 class="label">{h.rooms.listLabel}</h3>
      <ul class="rooms__list">
        {
          otherRooms.map((r) => (
            <li>
              <a href={r.href}>
                <span class="rooms__name">{r.name}</span>
                <span class="rooms__line">{r.line}</span>
                <span class="rooms__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <ReferencesWall lang={lang} class="rooms__refs container" />
  </section>

  <!-- 6 · Calm: one spot, crest, one line, one pill (still) -->
  <section class="encore" data-sc-act="flow" aria-labelledby="encore-title">
    <div class="encore__spot" aria-hidden="true"></div>
    <div class="encore__inner container">
      <Crest width={88} alt="" class="encore__crest" />
      <span class="light-line encore__line" aria-hidden="true"></span>
      <h2 id="encore-title">{h.encore.heading}</h2>
      <p class="encore__body">{h.encore.body}</p>
      <InquiryCTA lang={lang} />
      <p class="encore__mail">
        {mailBefore}<a class="tap-target" href={`mailto:${GROUP.email}`}>{GROUP.email}</a>{mailAfter}
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import '@/scripts/home-stage';
</script>

<style>
  /* Pinned stages sit under the sticky site header (--header-h, tokens.css). */
  .hero,
  .chord {
    --stage-h: calc(100svh - var(--header-h));
  }

  /* ---------- 1 · Hero ---------- */

  /* The headline is at most 12% of the window's height: on a short window a
     full-size one left singers 1 and 2's heads no room above the lead (#74). */
  .hero {
    --title-pad: clamp(var(--space-6), 7svh, var(--space-9));
    --title-size: min(var(--text-display), 12svh);
    position: relative;
    background: var(--color-bg);
  }

  .hero__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto auto;
    block-size: var(--stage-h);
    min-block-size: 34rem;
    overflow: clip;
    isolation: isolate;
    /* For the scene's width in a block offset (cqi), see .hero__scene. */
    container-type: inline-size;
  }

  /* Pin only where the whole stage fits under the header; on a short window
     (a scaled laptop, a phone on its side) the hero simply scrolls. The script
     reads a stage that is not sticky as a flow act. */
  @media (height >= 40rem) {
    :global(.sc-motion) .hero {
      block-size: calc(var(--span) * 100svh);
    }

    :global(.sc-motion) .hero__stage {
      position: sticky;
      top: var(--header-h);
    }

    :global(.sc-motion) .hero__title {
      transform: translateY(calc(var(--sc-p, 0) * -6svh));
      opacity: calc(1 - max(0, var(--sc-p, 0) - 0.6) * 2.5);
    }

    :global(.sc-motion) .hero__copy,
    :global(.sc-motion) .hero__caption {
      opacity: calc(1 - max(0, var(--sc-p, 0) - 0.5) * 2.5);
    }
  }

  /* One 3:2 frame holds every plane, so they line up by stacking. It covers the
     stage on wide screens and is art-directed to the singers on phones. */
  /* Not a stacking context (no z-index, transform or mask here), so the
     headline can sit between the planes. */
  /* On a short wide window the frame, 100% wide, is far taller than the stage
     and bottom-anchored, which lifted singers 1 and 2's heads behind the
     headline (#74). Their heads start at y 395 of 1200 (0.33 of the frame), so
     the frame drops until they clear the headline's foot (its top padding plus
     two lines at --title-size, leading 1). Elsewhere it keeps the -12% bottom offset. The
     frame's height comes from cqi, the stage's width: a % in a block offset
     would read the stage's height. */
  .hero__scene {
    --scene-w: max(100%, calc(var(--stage-h) * 1.5));
    --scene-h: calc(max(100cqi, var(--stage-h) * 1.5) / 1.5);
    position: absolute;
    inset-block-start: max(
      calc(112% - var(--scene-h)),
      calc(var(--title-pad) + 2 * var(--title-size) + var(--space-4) - 0.33 * var(--scene-h))
    );
    inset-inline-start: 50%;
    inline-size: var(--scene-w);
    aspect-ratio: 3 / 2;
    margin-inline-start: calc(var(--scene-w) / -2);
  }

  .hero__scene :global(.hero__far),
  .hero__scene :global(.hero__rim),
  .hero__scene :global(.hero__subject) {
    mask-image: linear-gradient(to bottom, transparent, var(--color-bg) 18%);
  }

  .hero__scene :global(img),
  .hero__haze {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .hero__scene :global(picture) {
    display: contents;
  }

  .hero__scene :global(.hero__far) {
    z-index: 0;
    transform-origin: 60% 40%;
  }

  .hero__haze {
    z-index: 1;
    background: var(--gradient-light);
    opacity: 0.28;
    mix-blend-mode: screen;
    mask-image: radial-gradient(60% 45% at 62% 18%, var(--color-bg), transparent 70%);
  }

  /* The rim comes first in the markup, so it sits under the singers. */
  .hero__scene :global(.hero__rim),
  .hero__scene :global(.hero__subject) {
    z-index: 3;
    transform-origin: 60% 85%;
  }

  .hero__scene :global(.hero__front) {
    z-index: 4;
    transform-origin: 50% 100%;
  }

  .hero__title {
    position: relative;
    z-index: 2;
    grid-row: 1;
    padding-block-start: var(--title-pad);
    max-inline-size: 14ch;
    font-size: var(--title-size);
    margin-inline: max(var(--gutter), calc((100% - var(--content-max)) / 2));
    text-wrap: balance;
  }

  .hero__scrim {
    position: absolute;
    inset: auto 0 0 0;
    block-size: 60%;
    z-index: 5;
    /* Density where the lead and the pills sit (bottom-left), not over the whole frame. */
    background:
      radial-gradient(75% 95% at 0% 100%, color-mix(in oklab, var(--color-bg) 94%, transparent) 45%, transparent 80%),
      linear-gradient(to top, var(--color-scrim), transparent 70%);
    pointer-events: none;
  }

  .hero__copy {
    position: relative;
    z-index: 6;
    grid-row: 3;
    display: grid;
    gap: var(--space-5);
    padding-block-end: var(--space-5);
  }

  .hero__lead {
    max-inline-size: 38ch;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-text-on-photo);
  }

  /* A short landscape window: two lines of lead, not three, so it starts below
     singers 1 and 2's chins (#74). Phones and upright screens keep the flow. */
  @media (width >= 48rem) and (orientation: landscape) and (height < 46rem) {
    .hero__lead {
      max-inline-size: 56ch;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .hero__caption {
    position: relative;
    z-index: 6;
    grid-row: 4;
    justify-self: end;
    margin: 0 var(--gutter) var(--space-4);
    color: var(--color-text-secondary);
  }

  /* Depth: the far plane barely moves, the singers rise a little, the front row
     slides out fastest, the headline recedes. Only under .sc-motion. */
  :global(.sc-motion) .hero__scene :global(.hero__far) {
    transform: scale(calc(1.06 - 0.05 * var(--sc-p, 0))) translateY(calc(var(--sc-p, 0) * -1.5%));
  }

  :global(.sc-motion) .hero__scene :global(.hero__rim),
  :global(.sc-motion) .hero__scene :global(.hero__subject) {
    transform: translateY(calc(var(--sc-p, 0) * -5%)) scale(calc(1 + 0.06 * var(--sc-p, 0)));
  }

  :global(.sc-motion) .hero__scene :global(.hero__front) {
    transform: translateY(calc(var(--sc-p, 0) * 16%)) scale(calc(1.02 + 0.14 * var(--sc-p, 0)));
  }

  /* Phones and upright screens (a tablet held portrait: the pinned stage there
     cut singer 5 off, #74): no pin. Headline, then the singers across the width
     (the planes still part as the hero scrolls by), then the lead and the date
     widget on plain ground. The script reads the stage as a flow act here. */
  @media (width < 48rem), (orientation: portrait) {
    :global(.sc-motion) .hero {
      block-size: auto;
    }

    .hero__stage,
    :global(.sc-motion) .hero__stage {
      position: relative;
      top: auto;
      block-size: auto;
      min-block-size: 0;
    }

    .hero__scene {
      --scene-w: 127%;
      position: relative;
      grid-row: 2;
      inset: auto;
      /* Start the frame 18.5% of its width early so the five fill the screen
         (they stand between 22% and 97% of it). */
      margin-inline-start: calc(var(--scene-w) * -0.185);
      margin-block: var(--space-6);
      /* The planes scale and shift; keep them inside the frame, off the type above and below. */
      overflow: clip;
    }

    .hero__scene :global(.hero__far),
    .hero__scene :global(.hero__rim),
    .hero__scene :global(.hero__subject),
    .hero__scene :global(.hero__front) {
      mask-image: linear-gradient(to bottom, transparent, var(--color-bg) 18%, var(--color-bg) 78%, transparent);
    }

    .hero__copy {
      padding-block-start: var(--space-4);
    }

    .hero__scrim {
      display: none;
    }

    /* Sized so the headline is two lines in its face down to 320px ("FIVE
       VOICES. / ONE HARMONY.", "PET GLASOVA. / JEDAN SKLAD."), and exactly those two lines are
       reserved, so the fallback font's wider wrap cannot push the photo down
       when the face loads (CLS). */
    .hero__title {
      font-size: min(var(--text-display), 12.5vw);
      block-size: calc(2lh + var(--title-pad));
    }

    .hero__lead {
      font-size: var(--text-body);
    }

    .hero__caption {
      justify-self: start;
    }

    :global(.sc-motion) .hero__title,
    :global(.sc-motion) .hero__copy,
    :global(.sc-motion) .hero__caption {
      transform: none;
      opacity: 1;
    }
  }

  /* ---------- 2 · Hush ---------- */

  .hush {
    display: grid;
    align-items: center;
    min-block-size: 90svh;
  }

  .hush__line {
    font-family: var(--font-headline);
    font-size: var(--text-title);
    font-weight: 800;
    line-height: var(--leading-heading);
    text-transform: uppercase;
    max-inline-size: 18ch;
    margin-inline: max(var(--gutter), calc((100% - var(--content-max)) / 2));
  }

  :global(.sc-motion) .hush__line {
    transition:
      opacity 900ms var(--ease-out),
      transform 900ms var(--ease-out);
  }

  :global(.sc-motion) .hush__line:not(:global(.is-in)) {
    opacity: 0;
    transform: translateY(1.5rem);
  }

  /* ---------- 3 · The chord ---------- */

  .chord {
    position: relative;
  }

  .chord__stage {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-5);
    overflow: clip;
    isolation: isolate;
  }

  /* Pinned only on windows wide and tall enough for head, portraits and foot;
     below that (phones, most tablets) the act scrolls by like any other, as
     tall as what it holds. The voices follow the music, not the scroll, so the
     pin only holds the stage while it plays. Only the pinned stage takes a
     height from the viewport, and only as a minimum: when 100svh comes out
     smaller than the content (iOS once reported the phone's width), the stage
     grows instead of the portraits spilling over the foot (#77). Below
     46rem of height (most laptops with browser chrome) the portraits would
     shrink to a strip, so the act flows there too. */
  @media (width >= 64rem) and (height >= 46rem) {
    :global(.sc-motion) .chord {
      block-size: calc(var(--span) * 100svh);
    }

    :global(.sc-motion) .chord__stage {
      position: sticky;
      top: var(--header-h);
