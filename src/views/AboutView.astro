---
// About (ticket C): the five with their portraits and voice parts in stage
// order, the story, the numbers (paired with the videos, never alone), the
// stages, the press as a rail of article cards (#41) and the management.
// Names, numbers and stages come from site-facts; portraits from photos.ts.
// JSON-LD: BreadcrumbList and FAQPage (the MusicGroup is site-wide).
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import ReferencesWall from '@/components/ReferencesWall.astro';
import VideoRail from '@/components/VideoRail.astro';
import ContentHero from '@/components/content/ContentHero.astro';
import CreditedPhoto from '@/components/content/CreditedPhoto.astro';
import EndCta from '@/components/content/EndCta.astro';
import FaqList from '@/components/content/FaqList.astro';
import NamedList from '@/components/content/NamedList.astro';
import PageFlow from '@/components/content/PageFlow.astro';
import PressRail, { type PressItem } from '@/components/content/PressRail.astro';
import Prose from '@/components/content/Prose.astro';
import { PORTRAITS } from '@/data/photos';
import { CHART_HIT, MEMBERS, NUMBERS, STAGES } from '@/data/site-facts';
import { format, getStrings, LOCALE_META, type Locale } from '@/i18n';
import { pathFor, type PageKey } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fillFacts } from '@/lib/copy';
import { getFaqs } from '@/lib/faq';
import { faqPageJsonLd } from '@/lib/jsonld';
import { breadcrumbsFor, loadPage } from '@/lib/page';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const page: PageKey = 'about';
const site = Astro.site!;
const copy = await loadPage(page, lang);
const t = getStrings(lang);
const a = t.content.about;
const faqs = await getFaqs(lang, page);
const stageContext: Record<string, string> = a.stages;
const dateFmt = new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// A press item may name a `logo`: the id of its outlet in the references set
// (src/content/references/), whose logo file it reuses. Otherwise the outlet's name shows in type.
const press: PressItem[] = await Promise.all(
  a.press.map(async (p) => {
    const key = 'logo' in p ? p.logo : undefined;
    const ref = key ? await getEntry('references', key) : undefined;
    if (key && !ref?.data.logo) throw new Error(`Press item ${p.outlet}: no logo in references/${key}.json`);
    return {
      outlet: p.outlet,
      logo: ref?.data.logo ? { src: ref.data.logo, mono: ref.data.mono } : undefined,
      date: dateFmt.format(new Date(`${p.date}T12:00:00Z`)),
      datetime: p.date,
      headline: p.headline,
      headlineLang: 'hr',
      what: p.what,
      url: p.url,
    };
  }),
);
const portraitCredit = [...new Set(MEMBERS.map((m) => PORTRAITS[m.key].credit))].join(', ');
const stages = STAGES.map((s) => ({ name: s.name, what: `${s.city[lang]}. ${stageContext[s.name] ?? ''}`.trim() }));
---

<BaseLayout
  lang={lang}
  page={page}
  title={copy.data.title}
  description={fillFacts(copy.data.description, lang)}
  ogPhoto="shootUpperTown"
  jsonLd={[breadcrumbsFor(site, page, lang), faqPageJsonLd(faqs)]}
>
  <PageFlow>
    <ContentHero lang={lang} heading={copy.data.heading} lead={fillFacts(a.lead, lang)} photo="selfieFive" />
    <section class="container members" aria-labelledby="members-heading">
      <div class="members__head">
        <h2 id="members-heading">{a.membersHeading}</h2>
        <p class="members__intro">{a.membersIntro}</p>
      </div>
      <ol class="members__list" role="list">
        {
          MEMBERS.map((m) => (
            <li class="members__item">
              <div class="members__photo">
                <Picture
                  src={PORTRAITS[m.key].src}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[240, 360, 480, 720]}
                  sizes="(min-width: 76rem) 14rem, (min-width: 48rem) 18vw, 45vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="members__given" aria-hidden="true">
                {m.givenName}
              </span>
              <span class="members__name">{m.name}</span>
              <span class="label">{m.voice[lang]}</span>
            </li>
          ))
        }
      </ol>
      <p class="members__credit">{format(t.content.photoCredit, { credit: portraitCredit })}</p>
    </section>
    <Prose lang={lang} html={copy.rendered?.html ?? ''} figure={{ near: CHART_HIT.song, photo: 'stageZlokicJozinovic' }} />
    <section class="container numbers" aria-labelledby="numbers-heading">
      <h2 id="numbers-heading">{a.numbersHeading}</h2>
      <dl class="numbers__list">
        {
          Object.values(NUMBERS).map((n) => (
            <div class="numbers__item">
              <dt class="numbers__label">{n.label[lang]}</dt>
              <dd class="numeral numbers__value">{n.display}</dd>
            </div>
          ))
        }
      </dl>
      <VideoRail lang={lang} limit={4} heading={false} />
    </section>
    <div class="container band">
      <CreditedPhoto photo="shootArmchair" lang={lang} sizes="(min-width: 76rem) 76rem, 100vw" />
    </div>
    <NamedList id="stages" heading={a.stagesHeading} items={stages} />
    <PressRail id="press" heading={a.pressHeading} intro={a.pressIntro} items={press} prevLabel={a.pressPrev} nextLabel={a.pressNext} />
    <ReferencesWall lang={lang} class="container" />
    <section class="container management" aria-labelledby="management-heading">
      <h2 id="management-heading">{a.managementHeading}</h2>
      <p class="lead">{fillFacts(a.management, lang)}</p>
    </section>
    <FaqList lang={lang} id="faq" heading={t.content.faq.heading} faqs={faqs} more={{ href: pathFor('faq', lang), label: t.content.faq.all }} />
    <EndCta lang={lang} />
  </PageFlow>
</BaseLayout>

<style>
  .members,
  .numbers,
  .management {
    display: grid;
    gap: var(--space-6);
  }

  .members__head {
    display: grid;
    gap: var(--space-3);
  }

  .members__intro {
    color: var(--color-text-secondary);
  }

  /* Two to a row on phones, the five in one row from tablets up, in stage order. */
  .members__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
  }

  @media (min-width: 48rem) {
    .members__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .members__item {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    max-inline-size: none;
  }

  .members__photo {
    position: relative;
    margin-block-end: var(--space-3);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-bg-surface);
  }

  .members__photo :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  /* A thin line of stage light under each portrait, pink to blue across the five. */
  .members__photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    block-size: 3px;
    background: var(--color-border);
  }

  .members__item:nth-child(1) .members__photo::after {
    background: var(--brand-pink);
  }

  .members__item:nth-child(3) .members__photo::after {
    background: var(--brand-purple);
  }

  .members__item:nth-child(5) .members__photo::after {
    background: var(--brand-blue);
  }

  .members__credit {
    max-inline-size: none;
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    text-align: end;
  }

  .members__given {
    font-family: var(--font-headline);
    font-weight: 800;
    font-size: var(--text-title);
    line-height: 1;
    text-transform: uppercase;
  }

  .members__name {
    color: var(--color-text);
  }

  .numbers__list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-6);
  }

  .numbers__item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
  }

  .numbers__value {
    margin: 0;
    font-size: var(--text-display);
  }

  .numbers__label {
    color: var(--color-text-secondary);
  }

  .band :global(.credited-photo) {
    --photo-ratio: 16 / 9;
  }
</style>
